{
  "name": "caja-familiar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vitest run src/utils/debtDocumentFirstOnboarding.test.ts src/utils/universalDebtContract.test.ts && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:debt2b2": "node scripts/test-debt2b2.mjs",
    "test:bank-v2-local": "node scripts/test-bank-v2-local.mjs",
    "test:bank-loan-v3:local": "node scripts/test-bank-loan-onboarding-v3-local.mjs",
    "test:bank-prepayment-lifecycle:local": "node scripts/test-bank-prepayment-lifecycle-local.mjs",
    "test:bank-reconstruction-v4": "vitest run src/utils/bankContractReconstruction.test.ts",
    "test:bank-prepayment-simulation": "vitest run src/utils/bankPrepaymentSimulation.test.ts",
    "test:bank-external-ai-import": "vitest run src/utils/bankExternalAiImport.test.ts src/utils/bankDocumentCompleteness.test.ts api/bank-document/capabilities.test.ts",
    "test:bank-document-v5-local": "vitest run src/utils/bankDocumentExtraction.test.ts src/utils/debtScheduleFileParser.test.ts api/_lib/bankDocumentAi.test.ts api/_lib/bankDocumentCost.test.ts api/_lib/bankDocumentSecurity.test.ts api/bank-document/analyze.test.ts",
    "test:universal-debt-contract-engine": "vitest run src/utils/universalDebtContract.test.ts src/components/DebtRefinanceForm.test.tsx && node scripts/check-universal-debt-contract-engine.mjs",
    "test:universal-debt-contract-engine:local": "node scripts/test-universal-debt-contract-engine-local.mjs",
    "test:debt5fa:local": "node scripts/test-debt5fa-local.mjs",
    "test:recon1a:local": "node scripts/test-recon1a-local.mjs",
    "test:recon1c:local": "node scripts/test-recon1c-local.mjs",
    "test:supabase": "node scripts/test-supabase.mjs"
